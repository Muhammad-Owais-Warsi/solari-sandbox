# Solari server environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- Required ---

# Solari sandbox provider API key (sandbox.ts)
SOLARI_API_KEY=

# Google Gemini API key used by the LLM agent (agent.ts)
GEMINI_API_KEY=

# --- Git push / pull request ---
# Provide either a GitHub token or a git password to enable push + create_pr.
# One of these is enough; GITHUB_TOKEN takes precedence (sandbox.ts, tools.ts).
GITHUB_TOKEN=
# GIT_PASSWORD=

# Username used when pushing (defaults to "solari-agent")
GIT_USERNAME=

# --- Optional ---

# Override the Gemini model (defaults to "gemini-3.1-flash-lite")
# GEMINI_MODEL=
